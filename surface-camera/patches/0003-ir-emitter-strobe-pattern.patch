+/*
+ * Surface Pro 7: the sensor's STROBE output drives the IR emitter. Pattern
+ * register 0x3b81 values from the Windows driver: 0xff lights it on every
+ * frame, 0xaa on alternate frames. With a pattern set, the emitter is driven
+ * the way Windows does it (pattern + output enable, no frame-PWM mode), as
+ * found by surface-kit (linux-surface discussion #1353). 0 = off.
+ */
+static int strobe_pattern;
+module_param(strobe_pattern, int, 0644);
+MODULE_PARM_DESC(strobe_pattern, "IR emitter strobe pattern, 0x01-0xff (0 = off)");
+#define OV7251_STROBE_PATTERN			0x3b81
