+static bool ipu4p_csi2_apply_source6_ir_timing(struct ipu_isys_csi2 *csi2,
+					       unsigned int nlanes)
+{
+	const struct ipu4p_isys_quirks *quirks;
+	unsigned int i;
+
+	quirks = ipu4p_isys_get_quirks(&csi2->isys->adev->dev);
+	if (!quirks || csi2->index != 1 || nlanes != 1 ||
+	    csi2->asd.source != IPU_FW_ISYS_STREAM_SRC_CSI2_PORT0 + 6)
+		return false;
+
+	for (i = 0; i < nlanes; i++) {
