# howdy-git from the AUR (Maintainer: SelfRef <arch@selfref.dev>) plus a
# recorder for the Surface Pro 7 IR camera: surface_ir_reader.py and the
# hook in howdy-surface-ir.patch. Built by install-face.sh.

_pkgbase=howdy
pkgname=howdy-surface-git
pkgver=r592.d3ab993
pkgrel=1
pkgdesc="Windows Hello style facial authentication for Linux (Surface Pro 7 IR recorder)"
arch=('x86_64')
url="https://github.com/boltgolt/howdy"
license=('MIT')
makedepends=('git' 'meson' 'ninja' 'cmake')
depends=('libinih' 'libevdev' 'python' 'python-dlib' 'python-opencv' 'python-numpy' 'v4l-utils')
provides=('howdy')
conflicts=('howdy' 'howdy-git')
backup=('etc/howdy/config.ini')
install=howdy.install
source=(
	"howdy::git+https://github.com/boltgolt/howdy.git"
	"https://github.com/davisking/dlib-models/raw/master/dlib_face_recognition_resnet_model_v1.dat.bz2"
	"https://github.com/davisking/dlib-models/raw/master/mmod_human_face_detector.dat.bz2"
	"https://github.com/davisking/dlib-models/raw/master/shape_predictor_5_face_landmarks.dat.bz2"
	"polkit-agent-helper-howdy.conf"
	"howdy-surface-ir.patch"
	"surface_ir_reader.py"
)
md5sums=('SKIP'
         '1b31cc4419cc8f1018117249b64bd683'
         '5edccec8ac713d743be4865ff6ead7f7'
         'ef591cf713630226b35b11d0e1733118'
         '4a3f094d3123029f67a7e6885fcc49bb'
         'SKIP'
         'SKIP')

pkgver() {
	cd $_pkgbase
	( set -o pipefail
		git describe --long --abbrev=7 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g' ||
		printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
	)
}

prepare() {
	cd "$srcdir/$_pkgbase"
	patch -p1 < "$srcdir/howdy-surface-ir.patch"
	install -m644 "$srcdir/surface_ir_reader.py" howdy/src/recorders/surface_ir_reader.py
}

build() {
	# Upstream split into howdy/ and howdy-gtk/ meson projects (no top-level
	# meson.build any more); build just the howdy one.
	cd "$srcdir"
	arch-meson "$_pkgbase/howdy" build
	meson compile -C build
}

package() {
	cd "$srcdir"
	meson install -C build --destdir "$pkgdir"
	install -Dm644 "$_pkgbase/howdy/src/config.ini" "$pkgdir/etc/howdy/config.ini"
	install -Dm644 "$_pkgbase/LICENSE" "$pkgdir/usr/share/licenses/$_pkgbase/LICENSE"

	cd "$srcdir"
	install -Dm644 -t "$pkgdir/usr/share/dlib-data" *.dat

	# Workaround for polkit 127+ breaking howdy (boltgolt/howdy#1077)
	install -Dm644 polkit-agent-helper-howdy.conf \
		"$pkgdir/usr/lib/systemd/system/polkit-agent-helper@.service.d/10-howdy.conf"
}
