// -*- mode: jsonc -*-
{
    "height": 32,
    "spacing": 6,

    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "custom/vpn",
        "pulseaudio",
        "battery",
        "clock",
        "tray"
    ],

    // ── Workspaces ──────────────────────────────────────────────
    // ext/workspaces, not hyprland/workspaces: on Hyprland's Lua config the
    // latter still sends old-style "dispatch workspace N", which Hyprland
    // rejects, so clicks did nothing (Waybar #5008, fixed after 0.15.0).
    // The scroll commands likewise need the Lua dispatcher syntax.
    "ext/workspaces": {
        // {name} is Hyprland's workspace number; {id} is the protocol's own
        // counter, which grows as workspaces come and go (2 showed as "4").
        "format": "{name}",
        "on-click": "activate",
        "sort-by-name": true,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },

    // ── Active window title ──────────────────────────────────────
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    // ── CPU ──────────────────────────────────────────────────────
    "cpu": {
        "interval": 2,
        "format": "{usage}% ",
        "tooltip": true,
        "tooltip-format": "CPU  {usage}%\n\nCore breakdown:\n{icon0} Core 1  {core0usage}%\n{icon1} Core 2  {core1usage}%\n{icon2} Core 3  {core2usage}%\n{icon3} Core 4  {core3usage}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    // ── Memory ──────────────────────────────────────────────────
    "memory": {
        "interval": 5,
        "format": "{}% ",
        "tooltip": true,
        "tooltip-format": "RAM  {percentage}%\n\nUsed:      {used:0.1f} GiB\nAvailable: {avail:0.1f} GiB\nTotal:     {total:0.1f} GiB\n\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
    },

    // ── Network ─────────────────────────────────────────────────
    // interface is pinned: without it waybar latches onto wg0 the moment
    // the tunnel comes up and reports the VPN instead of the Wi-Fi.
    "network": {
        // Glob, not a fixed name: this card is wlp0s20f3 here, wlan0 elsewhere.
        "interface": "wl*",
        // 1s, not 5s: a resume reconnects in well under ten seconds, so a 5s
        // poll left the bar reading "offline" long after the link was back --
        // which is what makes you reach for the picker unnecessarily.
        "interval": 1,
        "format-wifi": "{icon}  {essid}",
        // Associated but no IP yet. Without this the DHCP window also reads as
        // "offline", when it is really the last second of coming back.
        "format-linked": "  connecting",
        "format-disconnected": "  offline",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format-wifi": "{essid}   {signalStrength}%\n{ipaddr}/{cidr}\nvia {gwaddr}   ·   {frequency} GHz\n\nClick for the Wi-Fi picker\nRight-click for iwgtk",
        "tooltip-format-disconnected": "No Wi-Fi\n\nClick for the Wi-Fi picker",
        "on-click": "/home/slava/.local/bin/wifi-menu",
        "on-click-right": "iwgtk"
    },

    // ── VPN ──────────────────────────────────────────────────────
    "custom/vpn": {
        "exec": "/home/slava/.local/bin/vpn json",
        "return-type": "json",
        "interval": 5,
        "on-click": "/home/slava/.local/bin/vpn toggle",
        "tooltip": true
    },

    // ── Audio ────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "scroll-step": 2
    },

    // ── Battery ──────────────────────────────────────────────────
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}\nDraw: {power:.1f}W"
    },

    // ── Clock ────────────────────────────────────────────────────
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %b %d}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // ── Tray ─────────────────────────────────────────────────────
    "tray": {
        "spacing": 8
    }
}
