#!/usr/bin/env bash
# Show / hide / toggle the squeekboard on-screen keyboard.
#   osk [toggle|show|hide]

set -u

command -v squeekboard >/dev/null || { echo "osk: squeekboard not installed" >&2; exit 1; }

# Start squeekboard if it isn't running yet, then wait for its D-Bus name.
if ! pgrep -x squeekboard >/dev/null; then
  squeekboard >/dev/null 2>&1 &
  for _ in $(seq 20); do
    busctl --user status sm.puri.OSK0 >/dev/null 2>&1 && break
    sleep 0.1
  done
fi

case "${1:-toggle}" in
  show) v=true ;;
  hide) v=false ;;
  *)
    cur=$(busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible 2>/dev/null | awk '{print $2}')
    [ "$cur" = "true" ] && v=false || v=true
    ;;
esac

busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b "$v"
