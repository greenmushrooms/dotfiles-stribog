#!/usr/bin/env bash
# Let squeekboard pop up on text fields only when there is no usable
# hardware keyboard: the Type Cover is detached, or folded back (tablet
# mode). With the cover in use, auto-show is off and the keyboard is hidden.
# The bottom-edge swipe / `osk toggle` works either way.
#
#   osk-auto watch         run the watcher (started from hyprland.lua)
#   osk-auto tablet on|off called by the Tablet Mode Switch binds
#   osk-auto refresh       re-check now
#
# squeekboard follows the GNOME a11y setting screen-keyboard-enabled
# (stored in dconf), so flipping that is all it takes.

set -u

STATE="${XDG_RUNTIME_DIR:-/tmp}/osk-tablet-mode"
TABLET_FLAG="${XDG_RUNTIME_DIR:-/tmp}/no-hw-keyboard"
KEY="org.gnome.desktop.a11y.applications screen-keyboard-enabled"
# Any real keyboard counts (Type Cover, or a USB/Bluetooth one like the
# Keychron). Skip devices that only *look* like keyboards: power/volume
# buttons, virtual keyboards (squeekboard), and mice that expose a keyboard
# interface (Razer Pro Click). Override the skip list for other machines.
KB_IGNORE=${OSK_KB_IGNORE:-'video-bus|gpio-keys|virtual|power|sleep|button|hotkey|wmi|consumer-control|system-control|avrcp|click|mouse'}

has_keyboard() {
  hyprctl devices -j 2>/dev/null \
    | sed -n '/^"keyboards"/,/^\]/p' \
    | grep -o '"name": *"[^"]*"' | grep -vE -- "$KB_IGNORE" | grep -q .
}

refresh() {
  local want=false
  [ "$(cat "$STATE" 2>/dev/null)" = on ] && want=true
  has_keyboard || want=true

  [ "$(gsettings get $KEY)" = "$want" ] || gsettings set $KEY "$want"
  # Flag for hyprland.lua: in tablet use, new apps open on their own workspace.
  if [ "$want" = true ]; then : > "$TABLET_FLAG"; else rm -f "$TABLET_FLAG"; fi
  # Cover is back in use: drop a keyboard left open in tablet mode.
  [ "$want" = false ] && "$HOME/.local/bin/osk" hide >/dev/null 2>&1
  return 0
}

case "${1:-refresh}" in
  tablet)
    echo "${2:-off}" > "$STATE"
    refresh
    ;;
  watch)
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/osk-auto.lock"
    flock -n 9 || exit 0   # already running
    refresh
    # Re-check whenever an input device comes or goes (cover attach/detach).
    # Events arrive in bursts, so wait for them to settle before checking.
    udevadm monitor --udev --subsystem-match=input 2>/dev/null 9>&- \
      | while read -r _; do
          while read -r -t 1 _; do :; done
          refresh
        done
    ;;
  refresh) refresh ;;
  *) echo "usage: osk-auto [watch|refresh|tablet on|off]" >&2; exit 2 ;;
esac
