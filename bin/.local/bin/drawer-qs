#!/usr/bin/python3 -I
"""Show the quick-settings bar (brightness/volume sliders, close button)
while the nwg-drawer app drawer is open.

Follows Hyprland's event socket: openlayer>>nwg-drawer starts a small
waybar (~/.config/waybar/drawer-qs.*), closelayer>>nwg-drawer stops it.
Its exclusive zone pushes the drawer down, so the two never overlap.

    drawer-qs          run the watcher (started from hyprland.lua)
"""
import fcntl
import os
import socket
import subprocess
import sys
import time

HOME = os.environ["HOME"]
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
CFG = f"{HOME}/.config/waybar/drawer-qs.jsonc"
CSS = f"{HOME}/.config/waybar/drawer-qs.css"
NAMESPACE = "nwg-drawer"

# One watcher per session.
lock = open(f"{RUNTIME}/drawer-qs.lock", "w")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)

bar = None


def show():
    global bar
    if bar and bar.poll() is None:
        return
    bar = subprocess.Popen(
        ["waybar", "-c", CFG, "-s", CSS],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def hide():
    global bar
    if bar and bar.poll() is None:
        bar.terminate()
        try:
            bar.wait(2)
        except subprocess.TimeoutExpired:
            bar.kill()
    bar = None


def events():
    sock_path = (f"{RUNTIME}/hypr/"
                 f"{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/.socket2.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(sock_path)
        buf = b""
        while chunk := s.recv(4096):
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                yield line.decode(errors="replace")


try:
    while True:
        try:
            for ev in events():
                if ev == f"openlayer>>{NAMESPACE}":
                    show()
                elif ev == f"closelayer>>{NAMESPACE}":
                    hide()
        except OSError:
            pass
        time.sleep(2)  # Hyprland restarting; reconnect
finally:
    hide()
